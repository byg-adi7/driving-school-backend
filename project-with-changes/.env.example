# Copy to .env (gitignored) or export these as real environment variables.
# The application will fail to start if a required variable with no default is missing.
# This is intentional (fail-fast) - never put real secrets in application*.yml.
# Deploy target is Railway - see DEPLOYMENT.md for the full one-time setup.

# --- Database (required in every profile - no default) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=driving_school
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT (required in every profile - no default) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Redis (rate limiting + refresh-token revocation store) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS ---
# Defaults to the localhost dev origins below if unset, even in prod - update
# once your frontend has a real deployed URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Bootstrap admin (first ADMIN user created on startup) ---
# Disabled by default in prod (BOOTSTRAP_ADMIN_ENABLED) - enable for the very
# first deploy only, then flip back to false. If enabled with no password set,
# the app now boots fine and just skips creating the admin (logged as an
# error) rather than crashing - but set both together in practice.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Mail (password-reset emails + the EMAIL notification channel) ---
# Sent via Resend (https://resend.com) over plain HTTPS, not raw SMTP - most
# PaaS platforms (Railway included) block outbound SMTP entirely on
# free/hobby plans, and recommend an HTTPS-API provider regardless of plan.
# No default for RESEND_API_KEY - unset fails gracefully at send time
# (logged, not fatal), it just won't actually send anything.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend's dashboard, or
# the sandbox address (onboarding@resend.dev) for testing - which can only
# send to your own account email until a real domain is verified.
MAIL_FROM=

# --- Password reset ---
# Defaults to the localhost dev frontend if unset, even in prod (same
# reasoning as CORS_ALLOWED_ORIGINS) - this is the base URL embedded in every
# reset email's link. Update once your frontend has a real deployed URL.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRATION_MS=3600000

# --- File storage ---
# "local" (dev-only, blocked outright in prod), "gcs", or "cloudinary"
# (the default in prod if unset).
STORAGE_PROVIDER=local

# Required only when the *effective* provider is cloudinary (fails fast at
# startup if unset - checked after defaults are resolved, not just when this
# var is explicitly set). Copy the full value from the Cloudinary
# dashboard's "API Environment variable" - cloud name, key, and secret are
# all bundled in this one string, nothing else to configure.
CLOUDINARY_URL=

# Required only when the effective provider is gcs (same fail-fast timing as
# CLOUDINARY_URL above).
GCS_BUCKET_NAME=
# Optional - Application Default Credentials can auto-detect the project when
# running on GCP infrastructure. Set explicitly only if running outside GCP or
# ADC can't infer it (`gcloud auth application-default login` locally if you
# need to exercise the gcs provider outside GCP).
GCP_PROJECT_ID=

# --- OpenRouteService (practical lesson route planning) ---
# No default - get a free key at https://openrouteservice.org/dev/#/signup.
# Unset/invalid fails gracefully at request time (logged, not fatal).
OPENROUTE_API_KEY=

# --- Error tracking (optional) ---
# Stays off (no-op) if unset - do not set this to an empty string, that
# throws at startup instead of disabling cleanly. Get a DSN from sentry.io.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Local/dev only. Railway injects PORT directly - do not set this there.
SERVER_PORT=8080
