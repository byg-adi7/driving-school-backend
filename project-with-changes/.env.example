# Copy to .env (gitignored) or export these as real environment variables.
# The application will fail to start if a required variable with no default is missing.
# This is intentional (fail-fast) - never put real secrets in application*.yml.

# --- Database (required in every profile - no default) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=driving_school
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT (required in every profile - no default) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Bootstrap admin (first ADMIN user created on startup) ---
# Disabled by default in prod (BOOTSTRAP_ADMIN_ENABLED). If enabled, both must be set.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- File storage ---
# "local" (default, dev) or "gcs" (Google Cloud Storage, required in prod).
STORAGE_PROVIDER=local
# Required only when STORAGE_PROVIDER=gcs (fails fast at startup if unset).
GCS_BUCKET_NAME=
# Optional - Application Default Credentials can auto-detect the project on
# Cloud Run/GKE. Set explicitly only if running outside GCP or ADC can't infer it.
# Auth: no key file - uses the runtime's Application Default Credentials
# (the Cloud Run/GKE service account in prod; `gcloud auth application-default
# login` locally if you need to exercise the gcs provider outside GCP).
GCP_PROJECT_ID=

# --- OpenRouteService (practical lesson route planning) ---
OPENROUTE_API_KEY=

# Local/dev only. In prod, Cloud Run injects PORT directly - do not set this there.
SERVER_PORT=8080
