<?xml version="1.0" encoding="UTF-8"?>
<!--
  EI_EXPOSE_REP / EI_EXPOSE_REP2 findings are excluded project-wide after
  triaging all 120 instances from the baseline SpotBugs run (2026-07-16).
  Every one of them was one of:

    - A JPA entity holding a direct reference to another managed entity or
      collection (e.g. Booking.instructor, LessonNote.attachments,
      Vehicle.locations). This is standard Hibernate practice - wrapping
      these in defensive copies would fight Hibernate's own collection/proxy
      management for no real benefit, since these are transaction-scoped,
      database-backed objects with no attacker-reachable path to the kind of
      external aliasing this check protects against.
    - A Spring-managed singleton bean stored via constructor injection
      (ObjectMapper, RestTemplate, a repository, another service, a filter).
      This is literally how Spring dependency injection works; there is no
      meaningful "expose internal representation" risk in holding a
      reference to a shared, effectively-stateless collaborator bean.
    - A plain response DTO returning a List/Set it was built with (quiz
      questions, route coordinates, validation errors, role names). These
      are values the API caller already legitimately owns once the response
      is serialized - a client mutating their own local copy has no
      server-side effect.

  The one finding that touched genuinely security-relevant state -
  UserPrincipal.authorities, read by Spring Security's authorization checks -
  was fixed directly (wrapped in Set.copyOf(...), see UserPrincipal.java)
  rather than excluded here.
-->
<FindBugsFilter>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
